NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com
# Live StudioNet contract (deployed 2026-10-14):
NEXT_PUBLIC_CONTRACT_ADDRESS=0xA85005663e9368791Bc3Bdaf311138Eb4558C565
