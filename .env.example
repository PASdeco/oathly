# false = live on-chain reads/writes (needs wallet + StudioNet GEN). true = seeded demo data.
NEXT_PUBLIC_MOCK_MODE=false
# server / deploy only (never expose client-side, never commit):
BACKEND_PRIVATE_KEY=0x...
